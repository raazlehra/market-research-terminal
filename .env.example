# Server-only FYERS OAuth credentials. Never expose these through VITE_* variables.
FYERS_APP_ID=your_app_id
FYERS_SECRET=your_secret_key
FYERS_REDIRECT_URI=http://localhost:8000/fyers/callback
FRONTEND_URL=http://localhost:5173

# Long random value used to sign short-lived application session tokens.
APP_SESSION_SECRET=replace_with_at_least_48_random_characters
APP_SESSION_TTL_SECONDS=43200

# Fernet key generated with: python -m backend.migrate_tokens --initialize-local-secrets
FYERS_TOKEN_ENCRYPTION_KEY=replace_with_a_urlsafe_fernet_key
# For rotation, set comma-separated new-key,old-key values instead.
# FYERS_TOKEN_ENCRYPTION_KEYS=new_primary_key,old_decryption_key

DATABASE_URL=sqlite:///./fno.db

# Crypto uses Binance's public market-data-only host and needs no credentials.
# No crypto exchange API key, wallet seed, or private key is supported.

# Optional deep AI analysis. Disabled means deterministic local analysis only.
AI_ANALYSIS_ENABLED=false
AI_WORKER_URL=http://127.0.0.1:8124
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1800

# Hosted providers may charge money. Configure their server-side key only after
# reviewing that provider's current pricing; never use a VITE_* variable.
